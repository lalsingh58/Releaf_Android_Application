
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F9F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <!-- ReLeaf logo placeholder -->
        <ImageView
            android:id="@+id/ivReLeafLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/releaf_logo"
            android:contentDescription="ReLeaf logo"
            android:scaleType="fitCenter" />

        <!-- App title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Welcome to ReLeaf"
            android:textColor="#238B57"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Small actions. Cleaner air."
            android:textColor="#6B7280"
            android:textSize="15sp" />

        <!-- Username -->

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="42dp"
            android:paddingHorizontal="16dp"
            android:hint="Email Address"
            android:singleLine="true"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:background="@drawable/releaf_card" />

        <!-- Password -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp"
            android:hint="Password"
            android:singleLine="true"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:background="@drawable/releaf_card" />

        <!-- Login button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:text="Login"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="14dp"
            app:backgroundTint="#238B57" />

        <!-- Login status and errors -->
        <TextView
            android:id="@+id/tvLoginStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="#B91C1C"
            android:textSize="13sp"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:id="@+id/tvGoToRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:padding="10dp"
            android:text="New to ReLeaf? Create an account"
            android:textColor="#238B57"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
