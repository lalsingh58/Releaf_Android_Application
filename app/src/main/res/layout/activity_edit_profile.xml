
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textColor="#174D35"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Update your ReLeaf account details"
            android:textColor="#68766D"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Email Address"
            android:textColor="#174D35"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/releaf_card"
            android:enabled="false"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:inputType="textEmailAddress"
            android:hint="Email address" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Full Name"
            android:textColor="#174D35"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditFullName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/releaf_card"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:inputType="textPersonName"
            android:hint="Enter your full name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Bio"
            android:textColor="#174D35"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditBio"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/releaf_card"
            android:gravity="top|start"
            android:padding="16dp"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="500"
            android:hint="Tell us about yourself" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="City"
            android:textColor="#174D35"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditCity"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/releaf_card"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:inputType="textCapWords"
            android:maxLength="100"
            android:hint="Enter your city" />

        <TextView
            android:id="@+id/tvEditProfileStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#41634E"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Save Changes" />

        <Button
            android:id="@+id/btnCancelEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cancel" />

    </LinearLayout>
</ScrollView>
